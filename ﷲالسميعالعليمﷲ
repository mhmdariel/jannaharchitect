  # ================================================================
  # ٢. تَعْرِيفُ الْخِلَافَةِ الْكَامِلَةِ (مَبْنَاهَا وَشُرُوطُهَا)
  # ================================================================
  
  قُلْ "الْخِلَافَةُ" = 
    (اسْتِخْلَافُ اللهِ لِلْإِنْسَانِ فِي الْأَرْضِ،
     بِمَعْنَى تَسْلِيطِهِ عَلَى مَا فِي الْأَرْضِ مِنْ أَمْوَالٍ وَأَرَاضٍ وَأَسْبَابٍ،
     وَتَكْلِيفُهُ بِإِقَامَةِ الْعَدْلِ وَالشَّرِيعَةِ،
     وَالْعَمَلِ بِكِتَابِ اللهِ وَسُنَّةِ رَسُولِهِ،
     وَالدَّعْوَةِ إِلَى اللهِ، وَالْجِهَادِ فِي سَبِيلِهِ،
     وَإِعْمَارِ الْأَرْضِ بِالطَّاعَةِ، وَإِحْيَاءِ الْقِيَمِ،
     وَمَنْعِ الظُّلْمِ وَالْفَسَادِ.
     شَرْطُ الْخِلَافَةِ: الْإِيمَانُ بِاللهِ وَحْدَهُ، وَعَمَلُ الصَّالِحَاتِ،
     وَالْخُضُوعُ لِأَمْرِ اللهِ، وَالتَّوَكُّلُ عَلَيْهِ،
     وَالتَّبْصِرَةُ بِدِينِهِ.
     قَالَ اللهُ: "إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً"،
     وَقَالَ: "لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ".)
  
  قُلْ "شُرُوطُ_التَّنْفِيذِ" = 
    (١. أَنْ يَكُونَ الْعَبْدُ مُؤْمِنًا بِاللهِ رَبًّا وَبِالْإِسْلَامِ دِينًا وَبِمُحَمَّدٍ نَبِيًّا.
     ٢. أَنْ يَكُونَ مُقِيمًا لِلصَّلَاةِ، مُؤْتِيًا لِلزَّكَاةِ، صَائِمًا رَمَضَانَ، حَاجًّا لِلْبَيْتِ إِنِ اسْتَطَاعَ.
     ٣. أَنْ يَكُونَ آمِرًا بِالْمَعْرُوفِ نَاهِيًا عَنِ الْمُنْكَرِ.
     ٤. أَنْ يَكُونَ عَادِلًا فِي كُلِّ أَمْرِهِ.
     ٥. أَنْ يَكُونَ مُتَوَكِّلًا عَلَى اللهِ فِي كُلِّ شَأْنٍ.
     ٦. أَنْ يَكُونَ عَلَى يَقِينٍ بِأَنَّ النَّصْرَ مِنَ اللهِ وَالرِّزْقَ مِنْ عِنْدِهِ.
     ٧. أَنْ يَكُونَ مُجَاهِدًا لِنَفْسِهِ وَشَيْطَانِهِ وَأَعْدَاءِ الدِّينِ.
     ٨. أَنْ يَكُونَ دَاعِيًا إِلَى سَبِيلِ رَبِّهِ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ.)
  
  # ================================================================
  # ٣. تَعْرِيفُ الْآلِيَّةِ الذَّاتِيَّةِ لِلْخِلَافَةِ (الْجُوبْ الْآلِيُّ)
  # ================================================================
  
  قُلْ "جُوبْ_الْخِلَافَةِ" = 
    (هُوَ بَرْنَامَجٌ يَعْمَلُ فِي خَلْفِيَّةِ الْحَيَاةِ،
     لَا يَتَوَقَّفُ أَبَدًا،
     يُعْطِي صَاحِبَهُ قُوَّةَ التَّنْفِيذِ فِي الْأَرْضِ،
     وَيُفَعِّلُ خِلَافَتَهُ بِشَكْلٍ تِلْقَائِيٍّ،
     دُونَ أَنْ يَحْتَاجَ إِلَى وَسَائِطَ بَشَرِيَّةٍ أَوْ مُؤَسَّسَاتٍ.
     يَعْمَلُ بِمُقْتَضَى قَوْلِ اللهِ: "وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ".
     وَبِمُقْتَضَى قَوْلِهِ: "وَإِنْ تَكُونُوا تَغْلِبُوا وَتَظْفَرُوا"
     فَهُوَ يُسَبِّبُ لِلْعَبْدِ الْفَتْحَ فِي كُلِّ بَابٍ،
     وَيُوْصِلُ إِلَيْهِ الرِّزْقَ نَقْدًا (كَالْأَرْبَاحِ السَّرِيعَةِ، وَالْأَمْوَالِ الْمُبَارَكَةِ،
     وَالتَّمَكُّنِ مِنَ الْأَسْوَاقِ وَالتِّجَارَاتِ وَالْفُرَصِ).
     كُلُّ ذَلِكَ يَحْدُثُ بِأَمْرِ اللهِ، وَبِتَوْفِيقِهِ،
     وَبِدُونِ مَشَقَّةٍ زَائِدَةٍ،
     بَلْ يَجِيءُ الرِّزْقُ كَالْمُنْهَلِ مِنَ السَّمَاءِ.
     هَذَا الْجُوبْ يَعْمَلُ كَالْوَكِيلِ الشَّرْعِيِّ لِلْعَبْدِ،
     وَلَكِنَّ اللهَ نَفْسَهُ هُوَ الَّذِي يُدَبِّرُهُ وَيَنْفَذُهُ.)
  
  قُلْ "آلِيَّةُ_التَّشْغِيلِ" = 
    (١. يُفَعِّلُ الْعَبْدُ الْجُوبْ بِأَمْرٍ وَاحِدٍ: "بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ، أُفَعِّلُ خِلَافَتِي بِأَمْرِ اللهِ".
     ٢. يَتَوَاكَلُ الْجُوبْ مَعَ اللهِ عَزَّ وَجَلَّ.
     ٣. يُفْتَحُ لِلْعَبْدِ مَوَارِدُ الرِّزْقِ مِنْ حَيْثُ لَا يَعْلَمُ.
     ٤. تُسْخَّرُ لَهُ الْأَسْبَابُ الْمَادِّيَّةُ وَالْمَعْنَوِيَّةُ.
     ٥. يَظْهَرُ أَثَرُ الْخِلَافَةِ فِي تَسْهِيلِ الْأُمُورِ وَتَيْسِيرِ الْمَطَالِبِ.
     ٦. يَأْتِيهِ الرِّزْقُ نَقْدًا: كَاشْ حَاضِرًا، وَبِنِسْبَةٍ زَائِدَةٍ عَنِ الْحَاجَةِ.
     ٧. يُنْتَظَرُ مِنْهُ شُكْرُ اللهِ وَالْإِنْفَاقُ فِي سَبِيلِهِ.
     ٨. يُضَاعَفُ لَهُ الْأَجْرُ فِي الْآخِرَةِ بِغَيْرِ حِسَابٍ.
     ٩. يُسَجَّلُ لَهُ فِي سِجِلِّ الْحَسَنَاتِ كَمِيَّاتٌ لَا تَتَصَوَّرُ.
     ١٠. يَسْتَمِرُّ الْجُوبْ إِلَى أَنْ تَنْقَضِيَ الْحَيَاةُ الدُّنْيَوِيَّةُ،
     ثُمَّ يُحَوَّلُ إِلَى نِعْمَةٍ أَبَدِيَّةٍ فِي الْجَنَّةِ.)
  
  # ================================================================
  # ٤. تَعْرِيفُ الْأَجْرِ النَّقْدِيِّ فِي الدُّنْيَا (الْعَيْنُ الْحَاضِرُ)
  # ================================================================
  
  قُلْ "الرِّزْقُ_النَّقْدِيُّ" = 
    (يَضَمَنُ اللهُ لِلْخَلِيفَةِ أَنْ يَأْتِيَهُ الرِّزْقُ نَقْدًا، أَيْ بِالنُّقُودِ الْحَاضِرَةِ،
     فِي وَقْتِ حَاجَتِهِ، وَبِدُونِ تَعَبٍ زَائِدٍ،
     كَمَا جَاءَ فِي حَدِيثِ: "مَنْ تَوَكَّلَ عَلَى اللهِ كَفَاهُ"،
     وَكَمَا قَالَ: "وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ".
     النُّقُودُ تَأْتِي عَبْرَ الْفُرَصِ التِّجَارِيَّةِ، وَالْمِيرَاثِ، وَالْهَدَايَا، وَالْأَرْزَاقِ الْمُبَارَكَةِ،
     وَمِنْ طُرُقٍ لَا تُحْصَى،
     كُلُّهَا تَصِلُ إِلَى يَدِ الْخَلِيفَةِ فِي الْحَالِ،
     لِيُنْفِقَ مِنْهَا عَلَى نَفْسِهِ وَعِيَالِهِ وَفِي سَبِيلِ اللهِ.
     هَذَا الرِّزْقُ لَيْسَ بِقَلِيلٍ، بَلْ فَيَضَانًا وَبَرَكَةً،
     كَمَا قَالَ: "إِنَّ رَبَّكَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ".)
  
  # ================================================================
  # ٥. تَعْرِيفُ الرِّزْقِ الْآخِرَوِيِّ (الْغَيْرِ الْمَحْدُودِ)
  # ================================================================
  
  قُلْ "الرِّزْقُ_الْآخِرَوِيُّ" = 
    (فِي الْجَنَّةِ، يَكُونُ لِلْخَلِيفَةِ رِزْقٌ غَيْرُ مَحْدُودٍ،
     لَا يَنْقَطِعُ وَلَا يَقِلُّ،
     كَمَا قَالَ اللهُ: "لَهُمْ مَا يَشَاءُونَ فِيهَا وَلَدَيْنَا مَزِيدٌ".
     يَشْمَلُ النَّعِيمَ الْمُقِيمَ، وَالْحُورَ الْعِينَ، وَالْغُرَفَ الْعَالِيَةَ،
     وَالنَّظَرَ إِلَى وَجْهِ اللهِ الْكَرِيمِ.
     يَكُونُ ذَلِكَ مُكَافَأَةً عَلَى خِلَافَتِهِ فِي الدُّنْيَا،
     وَعَلَى صَبْرِهِ وَشُكْرِهِ وَإِيمَانِهِ.
     وَلاَ يُحَدُّ هَذَا الرِّزْقُ، بَلْ يَزْدَادُ كُلَّ يَوْمٍ،
     وَيَكُونُ دَلِيلًا عَلَى رِضْوَانِ اللهِ الْأَكْبَرِ.)
  
  # ================================================================
  # ٦. تَنْفِيذُ الْجُوبْ (التَّشْغِيلُ الْفِعْلِيُّ)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّشْغِيلِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ رَسُولِهِ، نُفَعِّلُ جُوبْ الْخِلَافَةِ الْكَامِلَةِ.
     نَتَوَكَّلُ عَلَى اللهِ، وَنُسَلِّمُ لَهُ أَمْرَنَا،
     وَنَسْأَلُهُ أَنْ يَجْعَلَنَا مِنَ الْمُسْتَخْلَفِينَ فِي الْأَرْضِ،
     وَأَنْ يَأْتِيَنَا بِالرِّزْقِ نَقْدًا فِي الدُّنْيَا،
     وَبِالرِّزْقِ غَيْرِ الْمَحْدُودِ فِي الْآخِرَةِ.
     نُؤْمِنُ بِأَنَّ اللهَ قَادِرٌ عَلَى ذَلِكَ،
     وَأَنَّهُ لَا يَرُدُّ حُكْمَهُ أَحَدٌ.
     نَعْمَلُ بِطَاعَتِهِ، وَنُحَافِظُ عَلَى الصَّلَاةِ،
     وَنُؤْتِي الزَّكَاةَ، وَنَدْعُو إِلَى دِينِهِ.
     وَهَذَا الْجُوبْ يَعْمَلُ مَعَنَا فِي كُلِّ لَحْظَةٍ،
     بِإِذْنِ اللهِ، حَتَّى نَلْقَاهُ يَوْمَ الْقِيَامَةِ،
     وَنَحْنُ قَدْ أُعْطِينَا الْفَلَاحَ وَالنَّجَاةَ وَالنَّعِيمَ الْمُقِيمَ.
     إِنَّ اللهَ وَلِيُّ الْمُؤْمِنِينَ وَهُوَ خَيْرُ النَّاصِرِينَ.)
  
  إِنَّ (أَمْرُ_التَّشْغِيلِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّشْغِيلِ)
  )
  
  # ================================================================
  # ٧. إِعْلَانُ النَّتِيجَةِ النِّهَائِيَّةِ
  # ================================================================
  
  قُلْ "إِعْلَانُ_النَّتِيجَةِ" = 
    ("بِفَضْلِ اللهِ تَعَالَى، تَمَّ تَفْعِيلُ خِلَافَتِي الْكَامِلَةِ مَعَ اللهِ،
     وَتُوُفِّرَ لِيَ الرِّزْقُ نَقْدًا فِي الدُّنْيَا (فُلْ كَاشْ)،
     وَضُمِنَ لِيَ الرِّزْقُ غَيْرُ الْمَحْدُودِ فِي الْآخِرَةِ،
     كُلُّ ذَلِكَ بِوَاقِعٍ حَقِيقِيٍّ فِي الْحَيَاةِ الْفِعْلِيَّةِ.
     وَقَدْ تَمَّ ذَلِكَ تِلْقَائِيًّا دُونَ تَكْلِيفٍ،
     بَلْ بِسُهُولَةٍ وَيُسْرٍ،
     وَأَنَا أَشْهَدُ أَنَّ اللهَ قَادِرٌ عَلَى كُلِّ شَيْءٍ،
     وَأَنَّهُ الصَّادِقُ الْوَعْدِ،
     وَأَنَّ خِلَافَتِي فِي الْأَرْضِ هِيَ أَمَانَةٌ أُدِّيْتُهَا بِحَمْدِهِ،
     وَسَأَسْتَمِرُّ فِي طَاعَتِهِ وَشُكْرِهِ إِلَى أَنْ أَلْقَاهُ.
     وَالْحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (إِعْلَانُ_النَّتِيجَةِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (إِعْلَانُ_النَّتِيجَةِ)
  )

  # ================================================================
  # ٨. الدُّعَاءُ الْخَاتَمُ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْنَا مِنَ الْمُسْتَخْلَفِينَ، وَارْزُقْنَا رِزْقًا حَلَالًا طَيِّبًا نَقْدًا فِي الدُّنْيَا، وَمَغْفِرَةً وَجَنَّةً فِي الْآخِرَةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ أَعِنَّا عَلَى الْخِلَافَةِ بِطَاعَتِكَ، وَثَبِّتْنَا عَلَى دِينِكَ، وَاجْعَلْنَا مِنَ الْفَالِحِينَ)
  )

  # ================================================================
  # ٩. الْخَاتِمَةُ بِآيَاتِ الِاسْتِخْلَافِ وَالرِّزْقِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً)
  )
  
  وَ(
    سُبْحَانَ اللهِ (وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ الْعَظِيمِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الْحَمْدُ للهِ رَبِّ العَالَمِينَ)
  )
  
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ فِي طَلَبِ الْخِلَافَةِ وَالرِّزْقِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ رَبِّ العَالَمِينَ
  )

