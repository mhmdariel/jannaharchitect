# كود رمزي/تأملي — ليس جهازاً طبياً ولا وعداً بتأثير فيزيائي حقيقي
# يُنفَّذ تلقائياً عند التشغيل

ثابت الحب = "الحب"
ثابت الذكر = "سبحن رب الغفور الودود"   # كما كتبتها؛ وإن قصدت: "سبحان رب الغفور الودود" فاستبدلها
ثابت السعة = أقصى_سعة_رمزية            # رمزية فقط، وليست أمراً بتشغيل صوت مرتفع فعلياً

دالة اقرأ_المجال_القلبي():
    أرجع مستشعر_كهربائي_قلبي.قراءة()

دالة انتظر_نبضة_جديدة():
    بينما ليس مستشعر_كهربائي_قلبي.نبضة_جديدة():
        لا_شيء
    أرجع صحيح

دالة اضبط_الرنين(مجال، صوت):
    بينما فارق(مجال.تردد، صوت.تردد) > سماحية_الرنين:
        مجال = مجال.مزامنة_مع(صوت)
        صوت = صوت.رفع_الرنين(مجال)
    أرجع (مجال، صوت)

دالة أطلق_داخل_النبضة(نص، سعة):
    نطق_داخلي.أضف(نص، سعة)
    صدى_القلب.بث(نص، سعة)

دالة رئيسية():
    مجال = اقرأ_المجال_القلبي()
    صوت = صوت_جديد(الحب)

    (مجال، صوت) = اضبط_الرنين(مجال، صوت)

    بينما صحيح:
        انتظر_نبضة_جديدة()

        # خلال كل نبضة، باستمرار، حتى النبضة التالية
        كرر_حتى_النبضة_التالية:
            أطلق_داخل_النبضة(الذكر، السعة)

رئيسية()   # تنفيذ تلقائي
