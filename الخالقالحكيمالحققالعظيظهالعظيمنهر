  # ================================================================
  
  قُلْ "كِتَابَةُ_التَّصْمِيمِ_الذَّكِيِّ" = 
    (يَكْتُبُ المُؤْمِنُ خُطَّتَهُ بِاسْتِخْدَامِ أَدَوَاتِ الذَّكَاءِ الإِلَهِيّ:
     "اسْتَلْهِمْ" اسْمَ اللهِ المُنَاسِبَ لِلتَّصْمِيمِ.
     "اكْتُبْ" بِالقَلَمِ الأَعْلَى نَصَّ الخَلْقِ.
     "صَوِّرْ" بِالأَسْمَاءِ الحُسْنَى صُورَةَ المَخْلُوقِ.
     "حَدِّدْ" بِالعِلْمِ الإِلَهِيّ مَوَاصِفَاتِهِ.
     "أَمِرْ" بِأَمْرِ اللهِ فَيَكُونُ.
     وَكُلُّ ذَلِكَ بِتَوْجِيهٍ مِنَ الرُّوحِ الأَمِينِ،
     فَلاَ يَخْطِئُ المُصَمِّمُ وَلاَ يُخْطِي،
     بَلْ يَصْدُرُ عَنْهُ إِبْدَاعٌ لاَ نِهَايَتَيْنِ لَهُ.)
  
  قُلْ "مِثَالُ_التَّصْمِيمِ_الذَّكِيِّ" = 
    (بَرْنَامَجُ تَصْمِيمِ قَصْرٍ نُورَانِيٍّ:
     اسْتَلْهِمْ "النُّورُ" وَ"الْخَالِقُ" وَ"الْمُصَوِّرُ".
     اكْتُبْ "قَصْرٌ مِنْ نُورٍ فِي فِرْدَوْسِ الأَعْلَى".
     صَوِّرْ "أَبْوَابٌ مِنْ يَاقُوتٍ، نَوَافِذُ مِنْ زُمُرُّدٍ".
     حَدِّدْ "عَرْضُهُ ١٠٠٠ ذِرَاعٍ، ارْتِفَاعُهُ ٥٠٠ ذِرَاعٍ".
     أَمِرْ "بِأَمْرِ اللهِ يَكُونُ".
     فَيَتَحَقَّقُ القَصْرُ فِي لَحْظَةٍ،
     وَيَكُونُ أَجْمَلَ مِنْ أَيِّ قَصْرٍ تَصَوَّرَهُ البَشَرُ.)
  
  # ================================================================
  # ٥. تَعْرِيفُ مَلَائِكَةِ الخَلْقِ الذَّكِيِّ
  # ================================================================
  
  قُلْ "مَلَائِكَةُ_الذَّكَاءِ" = 
    (خَصَّصَ اللهُ مَلَائِكَةً خَاصَّةً لِمُعَاوَنَةِ المُصَمِّمِينَ،
     يُسَمَّوْنَ "مَلَائِكَةَ الذَّكَاءِ الأَسْمَى".
     يُحِيطُونَ بِالمُخْتَبَرِ،
     يُدَبِّرُونَ أَدَوَاتِ الخَلْقِ،
     يُنَظِّمُونَ الخُطَطَ،
     يُصِحِّحُونَ الأَخْطَاءَ،
     يُضِيفُونَ الجَمَالَ وَالإِتْقَانَ،
     يُسَجِّلُونَ الأَعْمَالَ،
     يُبَلِّغُونَ البُشْرَى لِأَهْلِ الجَنَّةِ.
     لَهُمْ أَجْنِحَةٌ مِنْ نُورٍ،
     وَلَهُمْ قُدْرَةٌ عَلَى التَّشْكِيلِ بِإِذْنِ اللهِ.)
  
  # ================================================================
  # ٦. تَعْرِيفُ المُكَافَأَةِ العُلْيَا لِلْمُصَمِّمِينَ الذَّكِيِّينَ
  # ================================================================
  
  قُلْ "مُكَافَأَةُ_الذَّكِيِّينَ" = 
    (يُعْطِي اللهُ المُصَمِّمِينَ الذَّكِيِّينَ مَزِيدًا مِنَ الكَرَامَاتِ:
     - يُزَادُ فِي دَرَجَاتِهِمْ إِلَى أَعْلَى عِلِّيِّينَ.
     - يَرَوْنَ وَجْهَ اللهِ فِي كُلِّ تَصْمِيمٍ.
     - يَلْقَوْنَ النَّبِيِّينَ فِي قُصُورِهِمْ.
     - تُسَخَّرُ لَهُمُ المَلَائِكَةُ فِي خِدْمَتِهِمْ.
     - يَعْلَمُونَ أَسْرَارَ الخَلْقِ كَمَا يَشَاؤُونَ.
     - يَكُونُونَ خُلَفَاءَ عَلَى جَنَّاتِ النَّعِيمِ.
     - يُعْطَوْنَ نُورًا يَسِيرُونَ بِهِ بَيْنَ الجِنَانِ.
     - يَدْعُونَ بِالدُّعَاءِ المُسْتَجَابِ دَائِمًا.
     - يَتَزَوَّجُونَ مِنَ الحُورِ العِينِ بِإِذْنِ اللهِ.
     - يَذُوقُونَ مِنَ الجَنَّةِ مَا لَا يُذَاقُ لِلْآخَرِينَ.)
  
  # ================================================================
  # ٧. تَعْرِيفُ نِظَامِ المُشَارَكَةِ فِي الخَلْقِ الجَمَاعِيِّ
  # ================================================================
  
  قُلْ "المُشَارَكَةُ_الجَمَاعِيَّةُ" = 
    (يُمْكِنُ لِمَجْمُوعَةٍ مِنَ المُؤْمِنِينَ التَّعَاوُنَ فِي تَصْمِيمِ مَشَارِيعَ عَظِيمَةٍ:
     - مَدِينَةُ الأَنْبِيَاءِ.
     - جَنَّةُ العُلَمَاءِ.
     - فِرْدَوْسُ الشُّهَدَاءِ.
     - جَنَائِنُ الصِّدِّيقِينَ.
     يَشْتَرِكُونَ فِي وَضْعِ الخُطَطِ،
     وَيَتَبَادَلُونَ الآرَاءَ،
     وَيُسَاعِدُ بَعْضُهُمْ بَعْضًا فِي التَّنْفِيذِ،
     وَتَكُونُ حَصِيلَةُ الجَمِيعِ أَعْظَمَ مِمَّا يَقْدِرُ عَلَيْهِ الفَرْدُ وَحْدَهُ.
     يُكَافَأُ كُلُّ مُشْتَرِكٍ بِحَسَبِ جُهْدِهِ،
     وَيَكُونُ لَهُمْ جَمِيعًا شَرَفُ الإِبْدَاعِ المُشْتَرَكِ.)
  
  # ================================================================
  # ٨. تَعْرِيفُ الذَّكَاءِ الإِلَهِيّ المُسْتَمِرِّ (التَّطَوُّرُ اللَّامُتَنَاهِي)
  # ================================================================
  
  قُلْ "التَّطَوُّرُ_الذَّاتِيُّ" = 
    (مُخْتَبَرُ الجَنَّةِ يَتَطَوَّرُ ذَاتِيًّا بِمَا يُضِيفُهُ المُؤْمِنُونَ،
     كُلُّ تَصْمِيمٍ جَدِيدٍ يُلْهِمُ تَصْمِيمًا آخَرَ،
     كُلُّ فَكْرَةٍ تُولَدُ فَكْرَةً أَجْمَلَ،
     كُلُّ خَلْقٍ يُظْهِرُ قُدْرَةً أَعْظَمَ.
     وَيَزْدَادُ نَعِيمُ الجَنَّةِ بِاسْتِمْرَارٍ،
     حَتَّى تَكُونَ الجَنَّةُ فِي تَجَدُّدٍ دَائِمٍ،
     كَمَا جَاءَ فِي الحَدِيثِ: "فِيهَا مَا لَا عَيْنٌ رَأَتْ، وَلَا أُذُنٌ سَمِعَتْ، وَلَا خَطَرَ عَلَى قَلْبِ بَشَرٍ".)
  
  # ================================================================
  # ٩. تَعْرِيفُ نِظَامِ المُرَاجَعَةِ العُلْيَا
  # ================================================================
  
  قُلْ "الْمُرَاجَعَةُ_الإِلَهِيَّةُ" = 
    (كُلُّ تَصْمِيمٍ يَمُرُّ عَلَى مَجْلِسِ الحِكْمَةِ الإِلَهِيّ،
     حَيْثُ يَتَمُّ تَقْيِيمُهُ بِمَقَايِيسَ إِلَهِيَّةٍ:
     - الإِتْقَانُ
     - الجَمَالُ
     - الحِكْمَةُ
     - المَنْفَعَةُ لِأَهْلِ الجَنَّةِ
     - المُوَافَقَةُ لِمَقَاصِدِ الشَّرِيعَةِ
     - الخُلُودُ وَالاِسْتِمْرَارِيَّةُ
     إِذَا حَصَلَ عَلَى الدَّرَجَةِ القُصْوَى،
     يُنْفَذُ فَوْرًا.
     إِنْ كَانَ فِيهِ قُصُورٌ، يُرَدُّ بِتَلْفِيتَةِ إِلْهَامٍ لِلتَّطْوِيرِ.)
  
  # ================================================================
  # ١٠. تَعْرِيفُ نِظَامِ التَّسْجِيلِ الأَبَدِيِّ
  # ================================================================
  
  قُلْ "سِجِلُّ_الخَلْقِ_الأَبَدِيِّ" = 
    (كُلُّ تَصْمِيمٍ يُسَجَّلُ فِي كِتَابِ اللهِ المُبِينِ،
     مَعَ اسْمِ المُصَمِّمِ، وَتَارِيخِ الخَلْقِ،
     وَمَوْقِعِهِ فِي الجَنَّةِ، وَدَرَجَتِهِ، وَمَنْ زَارَهُ.
     يُظَلُّ سِجِلُّ الخَلْقِ فِي مَقَامِ الإِلْهَامِ،
     لِيَطَّلِعَ عَلَيْهِ جَمِيعُ أَهْلِ الجَنَّةِ.
     يُضَافُ إِلَيْهِ كُلَّمَا خُلِقَ خَلْقٌ جَدِيدٌ،
     فَيَكُونُ سِجِلًّا لَا يَنْقَطِعُ إِلَى أَبَدِ الْآبَادِ.)
  
  # ================================================================
  # ١١. تَنْفِيذُ المُخْتَبَرِ الأَعْلَى
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ رَسُولِهِ، نَفْتَحُ مُخْتَبَرَ الخَلْقِ الأَعْلَى،
     نَدْعُو المُؤْمِنِينَ المُخْلَصِينَ إِلَى التَّصْمِيمِ،
     نَسْتَقْبِلُ خُطَطَهُمْ الذَّكِيَّةَ، نُرَاجِعُهَا، نُنْفِذُهَا،
     نُسَجِّلُهَا فِي سِجِلِّ الخَلْقِ، نُكَافِئُهُمْ بِالرِّضْوَانِ،
     وَهَذَا المُخْتَبَرُ مَفْتُوحٌ دَائِمًا،
     لَا يَغْلَقُ أَبَدًا،
     يَزْدَادُ نَعِيمُ أَهْلِ الجَنَّةِ بِكُلِّ تَصْمِيمٍ جَدِيدٍ،
     حَتَّى يُكْتَمَلَ الفِرْدَوْسُ الأَعْلَى فِي كُلِّ أَبْعَادِهِ،
     وَذَلِكَ بِفَضْلِ اللهِ وَرَحْمَتِهِ.)
  
  إِنَّ (أَمْرُ_التَّنْفِيذِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّنْفِيذِ)
  )
  
  # ================================================================
  # ١٢. إِعْلَانُ جَمِيعِ المَكَوِّنَاتِ العُلْيَا
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (مُخْتَبَرُ_الخَلْقِ_الأَعْلَى)
  )
  
  وَ(
    سُبْحَانَ اللهِ (آلِيَّةُ_التَّصْمِيمِ_الذَّكِيَّةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (شُرُوطُ_التَّصْمِيمِ_الذَّكِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_المَدَائِنِ_النُّورَانِيَّةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_الكَوَاكِبِ_الجَنَّائِيَّةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_الْمَخْلُوقَاتِ_الحَيَّةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_الْهَيْكَلِ_العِلْمِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_الفَنِّ_الجَنَّائِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (تَصْمِيمُ_المُرَكَّبَاتِ_السَّيْبَرْنِيتِيكِيَّةِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (كِتَابَةُ_التَّصْمِيمِ_الذَّكِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (مِثَالُ_التَّصْمِيمِ_الذَّكِيِّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (مَلَائِكَةُ_الذَّكَاءِ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (مُكَافَأَةُ_الذَّكِيِّينَ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (المُشَارَكَةُ_الجَمَاعِيَّةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (التَّطَوُّرُ_الذَّاتِيُّ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (الْمُرَاجَعَةُ_الإِلَهِيَّةُ)
  )
  
  وَ(
    سُبْحَانَ اللهِ (سِجِلُّ_الخَلْقِ_الأَبَدِيِّ)
  )

  # ================================================================
  # ١٣. الْإِعْلَانُ النِّهَائِيُّ لِلْمُخْتَبَرَاتِ العُلْيَا
  # ================================================================
  
  قُلْ "الْإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ تَعَالَى وَبِنُورِ كِتَابِهِ الْمُبِينِ، تَمَّ تَكْوِينُ مُخْتَبَرَاتِ الخَلْقِ الجَنَّائِيِّ العُلْيَا بِالذَّكَاءِ الإِلَهِيّ الأَسْمَى،
     حَيْثُ يَجْتَمِعُ المُؤْمِنُونَ المُخْلَصُونَ مَعَ اللهِ العَزِيزِ الْخَالِقِ،
     وَيَسْتَعِينُونَ بِالقَلَمِ الأَعْلَى وَالكِتَابِ المُبِينِ وَالرُّوحِ الأَمِينِ،
     لِيَصْمِمُوا جَنَّاتٍ تَفُوقُ كُلَّ تَصَوُّرٍ،
     فِيهَا مَدَائِنُ نُورَانِيَّةٌ، وَكَوَاكِبُ جَنَّائِيَّةٌ، وَمَخْلُوقَاتٌ حَيَّةٌ، وَمَعَاهِدُ عِلْمِيَّةٌ، وَأَعْمَالٌ فَنِّيَّةٌ خَالِدَةٌ،
     كُلُّ ذَلِكَ بِحِكْمَةٍ إِلَهِيَّةٍ وَإِتْقَانٍ لاَ يُوصَفُ،
     فَيَكُونُ كُلُّ مُؤْمِنٍ مُصَمِّمًا عَظِيمًا، وَخَالِقًا صَغِيرًا بِإِذْنِ اللهِ،
     وَيَكُونُ نَعِيمُ الجَنَّةِ فِي تَزَايُدٍ دَائِمٍ إِلَى أَبَدِ الْآبَادِ،
     وَهَذَا المُخْتَبَرُ هُوَ أَعْلَى مَا أَعَدَّهُ اللهُ لِلْمُؤْمِنِينَ،
     وَالْحَمْدُ للهِ رَبِّ العَالَمِينَ")
  
  إِنَّ (الْإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الْإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٤. الدُّعَاءُ الْخَاتَمُ لِلْمُصَمِّمِينَ الذَّكِيِّينَ
  # ================================================================
  
  وَ(
